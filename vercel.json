{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).(png|jpg|jpeg|webp|avif|svg|mp4|webm|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(sitemap.xml|robots.txt)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=3600" }
      ]
    }
  ],
  "redirects": [
    { "source": "/lp", "destination": "/?lp=1", "permanent": true },
    { "source": "/sobre-lp", "destination": "/sobre?lp=1", "permanent": true },
    { "source": "/pet-luxo-lp", "destination": "/pet-luxo?lp=1", "permanent": true },
    { "source": "/modalidades/viagem-na-cabine-lp", "destination": "/modalidades/viagem-na-cabine?lp=1", "permanent": true },
    { "source": "/modalidades/bagagem-acompanhada-lp", "destination": "/modalidades/bagagem-acompanhada?lp=1", "permanent": true },
    { "source": "/modalidades/compartimento-de-cargas-lp", "destination": "/modalidades/compartimento-de-cargas?lp=1", "permanent": true },
    { "source": "/modalidades/suporte-emocional-lp", "destination": "/modalidades/suporte-emocional?lp=1", "permanent": true },
    { "source": "/destinos/estados-unidos-lp", "destination": "/destinos/estados-unidos?lp=1", "permanent": true },
    { "source": "/destinos/portugal-lp", "destination": "/destinos/portugal?lp=1", "permanent": true },
    { "source": "/destinos/espanha-lp", "destination": "/destinos/espanha?lp=1", "permanent": true },
    { "source": "/destinos/italia-lp", "destination": "/destinos/italia?lp=1", "permanent": true },
    { "source": "/destinos/argentina-lp", "destination": "/destinos/argentina?lp=1", "permanent": true },
    { "source": "/destinos/uruguai-lp", "destination": "/destinos/uruguai?lp=1", "permanent": true },
    { "source": "/destinos/paraguai-lp", "destination": "/destinos/paraguai?lp=1", "permanent": true }
  ],
  "rewrites": [
    { "source": "/sobre", "destination": "/index.html" },
    { "source": "/quem-somos", "destination": "/index.html" },
    { "source": "/design-system/botoes", "destination": "/index.html" },
    { "source": "/destinos/(.*)", "destination": "/index.html" },
    { "source": "/modalidades/(.*)", "destination": "/index.html" },
    { "source": "/pet-luxo", "destination": "/index.html" },
    { "source": "/analise", "destination": "/index.html" },
    { "source": "/viajar", "destination": "/index.html" },
    { "source": "/obrigado", "destination": "/index.html" },
    { "source": "/en", "destination": "/en/index.html" },
    { "source": "/es", "destination": "/es/index.html" },
    { "source": "/ja", "destination": "/ja/index.html" },
    { "source": "/en/destinos/(.*)", "destination": "/en/index.html" },
    { "source": "/es/destinos/(.*)", "destination": "/es/index.html" },
    { "source": "/ja/destinos/(.*)", "destination": "/ja/index.html" },
    { "source": "/en/analise", "destination": "/en/index.html" },
    { "source": "/es/analise", "destination": "/es/index.html" },
    { "source": "/ja/analise", "destination": "/ja/index.html" },
    { "source": "/en/viajar", "destination": "/en/index.html" },
    { "source": "/es/viajar", "destination": "/es/index.html" },
    { "source": "/ja/viajar", "destination": "/ja/index.html" },
    { "source": "/en/obrigado", "destination": "/en/index.html" },
    { "source": "/es/obrigado", "destination": "/es/index.html" },
    { "source": "/ja/obrigado", "destination": "/ja/index.html" }
  ]
}
